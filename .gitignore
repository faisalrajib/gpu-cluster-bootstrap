@'
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging files
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE files (VS Code / PyCharm)
.vscode/
.idea/

# Operating System Files
Thumbs.db
db.properties
Desktop.ini
.DS_Store
.directory

# Docker Local Logs
*.log
.docker/
'@ | Out-File -FilePath .gitignore -Encoding utf8